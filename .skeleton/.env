# ------------------------------------------------------------------------------
# Plume version override. Update this value and restart your containers
# (i.e. 'docker compose up -d') to update your installation.
# ------------------------------------------------------------------------------

# PLUME_VERSION=latest

# ------------------------------------------------------------------------------
# The Plume server port to be exposed to the host.
# ------------------------------------------------------------------------------

# PLUME_PORT=8076

# ------------------------------------------------------------------------------
# Path to the Plume data directories. These paths may be absolute or relative
# to the 'docker-compose.yaml' file.
# ------------------------------------------------------------------------------

# PLUME_DATA_PATH=./data
# PLUME_THEME_PATH=./themes

# ------------------------------------------------------------------------------
# Host process user and group IDs. Setting these will map the host user/group
# to the user/group running within the container. This helps avoid permission
# issues between your host machine and docker container.
# ------------------------------------------------------------------------------

# HOST_USER_ID=
# HOST_GROUP_ID=
